2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z\" clip-rule=\"evenodd\"></path></svg></a><a href=\"#\" class=\"text-gray-400 hover:text-gray-500 dark:hover:text-gray-200\"><span class=\"sr-only\">Twitter</span><svg fill=\"currentColor\" viewBox=\"0 0 24 24\" class=\"h-6 w-6\" aria-hidden=\"true\"><path d=\"M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84\"></path></svg></a><a href=\"https://github.com/sandypockets\" class=\"text-gray-400 hover:text-gray-500 dark:hover:text-gray-200\"><span class=\"sr-only\">GitHub</span><svg fill=\"currentColor\" viewBox=\"0 0 24 24\" class=\"h-6 w-6\" aria-hidden=\"true\"><path fill-rule=\"evenodd\" d=\"M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z\" clip-rule=\"evenodd\"></path></svg></a><a href=\"#\" class=\"text-gray-400 hover:text-gray-500 dark:hover:text-gray-200\"><span class=\"sr-only\">Dribbble</span><svg fill=\"currentColor\" viewBox=\"0 0 24 24\" class=\"h-6 w-6\" aria-hidden=\"true\"><path fill-rule=\"evenodd\" d=\"M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10c5.51 0 10-4.48 10-10S17.51 2 12 2zm6.605 4.61a8.502 8.502 0 011.93 5.314c-.281-.054-3.101-.629-5.943-.271-.065-.141-.12-.293-.184-.445a25.416 25.416 0 00-.564-1.236c3.145-1.28 4.577-3.124 4.761-3.362zM12 3.475c2.17 0 4.154.813 5.662 2.148-.152.216-1.443 1.941-4.48 3.08-1.399-2.57-2.95-4.675-3.189-5A8.687 8.687 0 0112 3.475zm-3.633.803a53.896 53.896 0 013.167 4.935c-3.992 1.063-7.517 1.04-7.896 1.04a8.581 8.581 0 014.729-5.975zM3.453 12.01v-.26c.37.01 4.512.065 8.775-1.215.25.477.477.965.694 1.453-.109.033-.228.065-.336.098-4.404 1.42-6.747 5.303-6.942 5.629a8.522 8.522 0 01-2.19-5.705zM12 20.547a8.482 8.482 0 01-5.239-1.8c.152-.315 1.888-3.656 6.703-5.337.022-.01.033-.01.054-.022a35.318 35.318 0 011.823 6.475 8.4 8.4 0 01-3.341.684zm4.761-1.465c-.086-.52-.542-3.015-1.659-6.084 2.679-.423 5.022.271 5.314.369a8.468 8.468 0 01-3.655 5.715z\" clip-rule=\"evenodd\"></path></svg></a></div><p class=\"mt-8 text-center text-base text-gray-400 cursor-default\">© <!-- -->2026<!-- --> <span class=\"hover:text-transparent bg-clip-text bg-gradient-to-r bg-gradient-to-r from-pink-500 via-red-500 to-yellow-500\">Next.js Blog Starter</span>, Inc. All rights reserved.</p></div></div></footer></div></div><script id=\"__NEXT_DATA__\" type=\"application/json\">{\"props\":{\"pageProps\":{\"post\":{\"title\":\"Getting started with this template\",\"date\":\"2021-08-24T05:35:07.322Z\",\"slug\":\"getting-started\",\"author\":{\"name\":\"sandypockets\",\"picture\":\"/assets/blog/authors/sandypockets_avatar.jpg\"},\"content\":\"\\u003ch1\\u003eGetting started\\u003c/h1\\u003e\\n\\u003cp\\u003eThese steps will guide you through creating your own local copy of the project. You'll learn how to quickly get it up and running, so you can get back to creating your content.\\u003c/p\\u003e\\n\\u003cp\\u003eThis app was built and tested with Node \\u003ccode\\u003e14\\u003c/code\\u003e. It uses React \\u003ccode\\u003e17.0.2\\u003c/code\\u003e, the latest version of \\u003ccode\\u003eNext\\u003c/code\\u003e, and Tailwind CSS \\u003ccode\\u003e2.2.4\\u003c/code\\u003e. Check out the \\u003ccode\\u003epackage.json\\u003c/code\\u003e file for a complete list of dependencies.\\u003c/p\\u003e\\n\\u003ch2\\u003eUse create-next-app\\u003c/h2\\u003e\\n\\u003cp\\u003eCreate Next App is the fastest way to begin using this blog starter. You can use NPM or Yarn, but Yarn is recommended.\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003eReplace \\u003ccode\\u003emy-new-blog\\u003c/code\\u003e in either of the examples below (with whatever you'd like to use as the root directory), and run the command.\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cdiv\\u003e\\u003cpre\\u003e\\u003ccode class=\\\"language-unknown\\\"\\u003e# with npm\\nnpx create-next-app --example https://github.com/sandypockets/nextjs-blog-starter/tree/main my-new-blog\\u003c/code\\u003e\\u003c/pre\\u003e\\u003c/div\\u003e\\n\\u003cdiv\\u003e\\u003cpre\\u003e\\u003ccode class=\\\"language-shell\\\"\\u003e\\u003cspan\\u003e# with yarn\\u003c/span\\u003e\\n\\u003cspan\\u003eyarn\\u003c/span\\u003e create next-app \\u003cspan\\u003e--example\\u003c/span\\u003e https://github.com/sandypockets/nextjs-blog-starter/tree/main my-new-blog\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\u003c/div\\u003e\\n\\u003col start=\\\"2\\\"\\u003e\\n\\u003cli\\u003eOnce the project is created, change into the directory.\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cdiv\\u003e\\u003cpre\\u003e\\u003ccode class=\\\"language-shell\\\"\\u003e\\u003cspan\\u003ecd\\u003c/span\\u003e my-new-blog\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\u003c/div\\u003e\\n\\u003col start=\\\"3\\\"\\u003e\\n\\u003cli\\u003eInstall dependencies.\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cdiv\\u003e\\u003cpre\\u003e\\u003ccode class=\\\"language-shell\\\"\\u003e\\u003cspan\\u003eyarn\\u003c/span\\u003e \\u003cspan\\u003einstall\\u003c/span\\u003e\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\u003c/div\\u003e\\n\\u003cp\\u003eor if you used npm\\u003c/p\\u003e\\n\\u003cdiv\\u003e\\u003cpre\\u003e\\u003ccode class=\\\"language-shell\\\"\\u003e\\u003cspan\\u003enpm\\u003c/span\\u003e \\u003cspan\\u003einstall\\u003c/span\\u003e\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\u003c/div\\u003e\\n\\u003ch3\\u003eDevelopment server\\u003c/h3\\u003e\\n\\u003cp\\u003eYou can start the development server with \\u003ccode\\u003eyarn\\u003c/code\\u003e, \\u003ccode\\u003enpm\\u003c/code\\u003e, or \\u003ccode\\u003enext\\u003c/code\\u003e.\\u003c/p\\u003e\\n\\u003cdiv\\u003e\\u003cpre\\u003e\\u003ccode class=\\\"language-shell\\\"\\u003e\\u003cspan\\u003e# yarn\\u003c/span\\u003e\\n\\u003cspan\\u003eyarn\\u003c/span\\u003e dev\\n\\n\\u003cspan\\u003e# npm\\u003c/span\\u003e\\n\\u003cspan\\u003enpm\\u003c/span\\u003e dev\\n\\n\\u003cspan\\u003e# next\\u003c/span\\u003e\\nnext dev\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\u003c/div\\u003e\\n\\u003cp\\u003eOnce the server is running, visit \\u003ca href=\\\"http://localhost:3000\\\"\\u003ehttp://localhost:3000\\u003c/a\\u003e in your browser.\\u003c/p\\u003e\\n\\u003ch3\\u003eConstants\\u003c/h3\\u003e\\n\\u003cp\\u003eSet up each of the constants, much like you would a \\u003ccode\\u003e.env\\u003c/code\\u003e, in the \\u003ccode\\u003elib/constants.js\\u003c/code\\u003e file.\\u003c/p\\u003e\\n\\u003cdiv\\u003e\\u003cpre\\u003e\\u003ccode class=\\\"language-javascript\\\"\\u003e\\u003cspan\\u003eexport\\u003c/span\\u003e \\u003cspan\\u003econst\\u003c/span\\u003e \\u003cspan\\u003eEXAMPLE_PATH\\u003c/span\\u003e \\u003cspan\\u003e=\\u003c/span\\u003e \\u003cspan\\u003e'blog-starter'\\u003c/span\\u003e\\n\\u003cspan\\u003eexport\\u003c/span\\u003e \\u003cspan\\u003econst\\u003c/span\\u003e \\u003cspan\\u003eCMS_NAME\\u003c/span\\u003e \\u003cspan\\u003e=\\u003c/span\\u003e \\u003cspan\\u003e'Markdown'\\u003c/span\\u003e\\n\\u003cspan\\u003eexport\\u003c/span\\u003e \\u003cspan\\u003econst\\u003c/span\\u003e \\u003cspan\\u003eHOME_OG_IMAGE_URL\\u003c/span\\u003e \\u003cspan\\u003e=\\u003c/span\\u003e \\u003cspan\\u003e'https://og-image.vercel.app/Next.js%20Blog%20Starter%20Example.png?theme=light\\u0026#x26;md=1\\u0026#x26;fontSize=100px\\u0026#x26;images=https%3A%2F%2Fassets.vercel.com%2Fimage%2Fupload%2Ffront%2Fassets%2Fdesign%2Fnextjs-black-logo.svg'\\u003c/span\\u003e\\n\\u003cspan\\u003eexport\\u003c/span\\u003e \\u003cspan\\u003econst\\u003c/span\\u003e \\u003cspan\\u003eBLOG_NAME\\u003c/span\\u003e \\u003cspan\\u003e=\\u003c/span\\u003e \\u003cspan\\u003e'Next.js Blog Starter'\\u003c/span\\u003e\\n\\u003cspan\\u003eexport\\u003c/span\\u003e \\u003cspan\\u003econst\\u003c/span\\u003e \\u003cspan\\u003eKEYWORDS\\u003c/span\\u003e \\u003cspan\\u003e=\\u003c/span\\u003e \\u003cspan\\u003e'starter, blog, next.js, template'\\u003c/span\\u003e\\n\\u003cspan\\u003eexport\\u003c/span\\u003e \\u003cspan\\u003econst\\u003c/span\\u003e \\u003cspan\\u003eDESCRIPTION\\u003c/span\\u003e \\u003cspan\\u003e=\\u003c/span\\u003e \\u003cspan\\u003e'A starter blog template for Next.js'\\u003c/span\\u003e\\n\\u003cspan\\u003eexport\\u003c/span\\u003e \\u003cspan\\u003econst\\u003c/span\\u003e \\u003cspan\\u003eAUTHOR\\u003c/span\\u003e \\u003cspan\\u003e=\\u003c/span\\u003e \\u003cspan\\u003e'sandypockets'\\u003c/span\\u003e\\n\\u003cspan\\u003eexport\\u003c/span\\u003e \\u003cspan\\u003econst\\u003c/span\\u003e \\u003cspan\\u003eLANG\\u003c/span\\u003e \\u003cspan\\u003e=\\u003c/span\\u003e \\u003cspan\\u003e'en-CA'\\u003c/span\\u003e\\n\\u003cspan\\u003eexport\\u003c/span\\u003e \\u003cspan\\u003econst\\u003c/span\\u003e \\u003cspan\\u003eGITHUB_REPO\\u003c/span\\u003e \\u003cspan\\u003e=\\u003c/span\\u003e \\u003cspan\\u003e'https://github.com/sandypockets'\\u003c/span\\u003e\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\u003c/div\\u003e\\n\\u003ch3\\u003eGenerate a sitemap and robots.txt\\u003c/h3\\u003e\\n\\u003cp\\u003eSitemaps are an important part of SEO. This section walks through adding your base URL to the sitemap generator. The generator runs automatically after each build, generating a new sitemap each time you update your blog.\\u003c/p\\u003e\\n\\u003cp\\u003eThe generated sitemap can be found in \\u003ccode\\u003epublic/sitemap.xml\\u003c/code\\u003e. This command also generates a new \\u003ccode\\u003epublic/robots.txt\\u003c/code\\u003e file.\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003eOpen the \\u003ccode\\u003escripts/generate.sitemap.mjs\\u003c/code\\u003e file.\\u003c/li\\u003e\\n\\u003cli\\u003eOn Line 5, replace \\u003ccode\\u003ehttps://blog-starter.sandypockets.dev\\u003c/code\\u003e with your own blog's website.\\u003c/li\\u003e\\n\\u003cli\\u003eOn Line 6, replace \\u003ccode\\u003een-CA\\u003c/code\\u003e with your preferred locale (\\u003ccode\\u003een-UK\\u003c/code\\u003e, \\u003ccode\\u003een-US\\u003c/code\\u003e, etc.). This is used to determine the format of the date stamp in the sitemap.\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cp\\u003eWhen you're ready to test it:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003eRun \\u003ccode\\u003eyarn build\\u003c/code\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003eCheck the \\u003ccode\\u003epublic/\\u003c/code\\u003e directory for the \\u003ccode\\u003esitemap.xml\\u003c/code\\u003e file and \\u003ccode\\u003erobots.txt\\u003c/code\\u003e file.\\u003c/li\\u003e\\n\\u003cli\\u003eRun \\u003ccode\\u003eyarn start\\u003c/code\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003eVisit \\u003ccode\\u003ehttp://localhost:3000/sitemap.xml\\u003c/code\\u003e\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cp\\u003eIf you see the xml sitemap, then it was successful.\\u003c/p\\u003e\\n\\u003ch3\\u003eRSS Feed\\u003c/h3\\u003e\\n\\u003cp\\u003eAn RSS feed is available for the blog at \\u003ccode\\u003e/feed.xml\\u003c/code\\u003e. However, you must first configure the RSS generator to use your own URL.\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003eOpen the \\u003ccode\\u003escripts/generate-rss.mjs\\u003c/code\\u003e file.\\u003c/li\\u003e\\n\\u003cli\\u003eOn Line 7, replace the \\u003ccode\\u003ehttps://blog-starter.sandypockets.dev\\u003c/code\\u003e value of \\u003ccode\\u003eBLOG_URL\\u003c/code\\u003e with your own.\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cp\\u003eWhen you're ready to test it:\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003eRun \\u003ccode\\u003eyarn build\\u003c/code\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003eCheck the \\u003ccode\\u003epublic/\\u003c/code\\u003e directory for the \\u003ccode\\u003efeed.xml\\u003c/code\\u003e file.\\u003c/li\\u003e\\n\\u003cli\\u003eRun \\u003ccode\\u003eyarn start\\u003c/code\\u003e\\u003c/li\\u003e\\n\\u003cli\\u003eVisit \\u003ccode\\u003ehttp://localhost:3000/feed.xml\\u003c/code\\u003e\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cp\\u003eIf you see the xml RSS feed, then it was successful.\\u003c/p\\u003e\\n\\u003ch3\\u003eSet up Google Analytics\\u003c/h3\\u003e\\n\\u003cp\\u003eYou will need to have your Google tag ID. If you do not have one, or do not have a Google Analytics account, you can sign up at \\u003ca href=\\\"https://analytics.google.com/\\\"\\u003eanalytics.google.com\\u003c/a\\u003e\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003eCreate a copy of the \\u003ccode\\u003e.env.local.example\\u003c/code\\u003e file, and name it \\u003ccode\\u003e.env.local\\u003c/code\\u003e. In the terminal, run:\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cdiv\\u003e\\u003cpre\\u003e\\u003ccode class=\\\"language-shell\\\"\\u003e\\u003cspan\\u003ecp\\u003c/span\\u003e .env.local.example .env.local\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\u003c/div\\u003e\\n\\u003col start=\\\"2\\\"\\u003e\\n\\u003cli\\u003eGrab your Google tag ID from your Analytics account, and replace the \\u003ccode\\u003eG-XXXXXXXXXX\\u003c/code\\u003e in the new \\u003ccode\\u003e.env.local\\u003c/code\\u003e file you just created.\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003ch3\\u003eSet up SendGrid\\u003c/h3\\u003e\\n\\u003cp\\u003eYou will need a free SendGrid account, which allows you to send up to 100 emails each day. Replace the \\u003ccode\\u003eREPLACE-WITH-YOUR-API-KEY\\u003c/code\\u003e text in the `.env.exa\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003eGet your SendGrid API key from your SendGrid account.\\u003c/li\\u003e\\n\\u003cli\\u003eOpen the \\u003ccode\\u003e.env.local\\u003c/code\\u003e file that you created when setting up Google Analytics.\\u003c/li\\u003e\\n\\u003cli\\u003eReplace \\u003ccode\\u003eREPLACE-WITH-YOUR-API-KEY\\u003c/code\\u003e with your actual API key from SendGrid.\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003ch3\\u003eStorybook\\u003c/h3\\u003e\\n\\u003cp\\u003eStorybook is handy for crafting and tweaking components. Styling components in isolation this way can help make them more composable, since they're less reliant on the environment they're rendered in. Storybook runs on a separate server, so you can run it alongside the development server if you prefer.\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003eTo use Storybook, start the Storybook server.\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cdiv\\u003e\\u003cpre\\u003e\\u003ccode class=\\\"language-shell\\\"\\u003e\\u003cspan\\u003eyarn\\u003c/span\\u003e storybook\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\u003c/div\\u003e\\n\\u003col start=\\\"2\\\"\\u003e\\n\\u003cli\\u003eVisit \\u003ca href=\\\"http://localhost:6006/\\\"\\u003ehttp://localhost:6006/\\u003c/a\\u003e in your browser.\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003ch2\\u003eBuilding for production\\u003c/h2\\u003e\\n\\u003cp\\u003eWhile it's always a good idea to check out the build, it is especially important with Tailwind CSS. Tailwind purges unused classes to keep the build size light. However, if you've added classes dynamically with JavaScript, then you should be sure those classes weren't removed during build. Learn more in the \\u003ca href=\\\"https://tailwindcss.com/docs/optimizing-for-production\\\"\\u003eOptimizing for production\\u003c/a\\u003e section of the Tailwind docs.\\u003c/p\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003eStart building.\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cdiv\\u003e\\u003cpre\\u003e\\u003ccode class=\\\"language-shell\\\"\\u003e\\u003cspan\\u003eyarn\\u003c/span\\u003e build\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\u003c/div\\u003e\\n\\u003col start=\\\"2\\\"\\u003e\\n\\u003cli\\u003eOnce building is complete, run the build.\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cdiv\\u003e\\u003cpre\\u003e\\u003ccode class=\\\"language-shell\\\"\\u003e\\u003cspan\\u003eyarn\\u003c/span\\u003e start\\n\\u003c/code\\u003e\\u003c/pre\\u003e\\u003c/div\\u003e\\n\\u003col start=\\\"3\\\"\\u003e\\n\\u003cli\\u003eVisit \\u003ca href=\\\"http://localhost:3000\\\"\\u003ehttp://localhost:3000\\u003c/a\\u003e in your browser.\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003ch2\\u003eAdding content\\u003c/h2\\u003e\\n\\u003cp\\u003eLearn how to add content like blog posts or pages.\\u003c/p\\u003e\\n\\u003ch3\\u003eAdd a blog post\\u003c/h3\\u003e\\n\\u003col\\u003e\\n\\u003cli\\u003eAdd a new Markdown file (\\u003ccode\\u003e.md\\u003c/code\\u003e) to the \\u003ccode\\u003e/_posts\\u003c/code\\u003e directory.\\u003c/li\\u003e\\n\\u003cli\\u003eAdd the required front matter (described below) and adjust it as needed.\\u003c/li\\u003e\\n\\u003cli\\u003eImages related to the post should be stored in within the appropriate the \\u003ccode\\u003e/public/assets/blog\\u003c/code\\u003e directory. It is recommended you create a new folder for each blog post to prevent the images files from growing unwieldy.\\u003c/li\\u003e\\n\\u003cli\\u003eThat's it. Your new post will show up alongside the others on your homepage.\\u003c/li\\u003e\\n\\u003c/ol\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003eNote: The slug is the path that will be displayed, and is based on the title of your \\u003ccode\\u003e.md\\u003c/code\\u003e file. For example, \\u003ccode\\u003ekobe.md\\u003c/code\\u003e becomes \\u003ccode\\u003elocalhost:3000/posts/kobe\\u003c/code\\u003e\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ch4\\u003eHow it works\\u003c/h4\\u003e\\n\\u003cp\\u003eBlog posts are stored in the \\u003ccode\\u003e/_posts\\u003c/code\\u003e directory as Markdown files. To create a new post, simply add a new markdown file (\\u003ccode\\u003e.md\\u003c/code\\u003e) to the \\u003ccode\\u003e/_posts\\u003c/code\\u003e directory. Each post must include the appropriate front matter.\\u003c/p\\u003e\\n\\u003cp\\u003eTo create the blog posts we use \\u003ca href=\\\"https://github.com/remarkjs/remark\\\"\\u003e\\u003ccode\\u003eremark\\u003c/code\\u003e\\u003c/a\\u003e and \\u003ca href=\\\"https://github.com/remarkjs/remark-html\\\"\\u003e\\u003ccode\\u003eremark-html\\u003c/code\\u003e\\u003c/a\\u003e to convert the Markdown files into an HTML string, and then send it down as a prop to the page. The metadata of every post is handled by \\u003ca href=\\\"https://github.com/jonschlinkert/gray-matter\\\"\\u003e\\u003ccode\\u003egray-matter\\u003c/code\\u003e\\u003c/a\\u003e and also sent in props to the page.\\u003c/p\\u003e\\n\\u003ch5\\u003eFront matter\\u003c/h5\\u003e\\n\\u003cp\\u003eAn example of the required front matter:\\u003c/p\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003eNote: The formatting of the front matter is important. Ensure the indentation remains the same.\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003cdiv\\u003e\\u003cpre\\u003e\\u003ccode class=\\\"language-text\\\"\\u003e---\\ntitle: \\u0026#x26;#39;A blog starter you actually want to use\\u0026#x26;#39;\\nexcerpt: \\u0026#x26;#39;There are hundreds of different blog starters out there. But none felt quite right. So I built my own. Based off the basic Next.js Blog Starter, but now with several handy features like dark mode (using local storage) or Google Analytics. It comes with Storybook too.\\u0026#x26;#39;\\ncoverImage: \\u0026#x26;#39;/assets/blog/dynamic-routing/tree.jpg\\u0026#x26;#39;\\ndate: \\u0026#x26;#39;2021-08-24T05:35:07.322Z\\u0026#x26;#39;\\nauthor:\\n  name: sandypockets\\n  picture: \\u0026#x26;#39;/assets/blog/authors/sandypockets_avatar.jpg\\u0026#x26;#39;\\nogImage:\\n  url: \\u0026#x26;#39;/assets/blog/dynamic-routing/tree.jpg\\u0026#x26;#39;\\n---\\u003c/code\\u003e\\u003c/pre\\u003e\\u003c/div\\u003e\\n\\u003cp\\u003eAdjust the value of each key as needed.\\u003c/p\\u003e\\n\\u003ch3\\u003eAdd a page\\u003c/h3\\u003e\\n\\u003cp\\u003eNext.js makes routing easy. All pages live in the \\u003ccode\\u003e/pages\\u003c/code\\u003e directory. The file names used in that directory will map to the path in the browser.\\u003c/p\\u003e\\n\\u003cblockquote\\u003e\\n\\u003cp\\u003eExample: \\u003ccode\\u003e/pages/cool-page.jsx\\u003c/code\\u003e becomes \\u003ccode\\u003elocalhost:3000/pages/cool-page\\u003c/code\\u003e\\u003c/p\\u003e\\n\\u003c/blockquote\\u003e\\n\\u003ch3\\u003eManage global data\\u003c/h3\\u003e\\n\\u003cp\\u003eGlobal variables, like your blog's name, or your GitHub URL, can be managed in \\u003ccode\\u003e/lib/constants.js\\u003c/code\\u003e\\u003c/p\\u003e\\n\\u003cp\\u003eYou can adjust the blog's metadata (some of which relies on the global variables described above) can be adjusted in the \\u003ccode\\u003e/components/Layout/Meta.jsx\\u003c/code\\u003e component.\\u003c/p\\u003e\\n\",\"ogImage\":{\"url\":\"/assets/blog/getting-started/cover.jpg\"},\"coverImage\":\"/assets/blog/getting-started/snowy-mountain.jpg\"}},\"__N_SSG\":true},\"page\":\"/posts/[slug]\",\"query\":{\"slug\":\"getting-started\"},\"buildId\":\"EAmQPcL6IFOUF1wlMAJFx\",\"isFallback\":false,\"gsp\":true,\"scriptLoader\":[]}</script></body></html>","json":{"pageProps":{"post":{"title":"Getting started with this template","date":"2021-08-24T05:35:07.322Z","slug":"getting-started","author":{"name":"sandypockets","picture":"/assets/blog/authors/sandypockets_avatar.jpg"},"content":"<h1>Getting started</h1>\n<p>These steps will guide you through creating your own local copy of the project. You'll learn how to quickly get it up and running, so you can get back to creating your content.</p>\n<p>This app was built and tested with Node <code>14</code>. It uses React <code>17.0.2</code>, the latest version of <code>Next</code>, and Tailwind CSS <code>2.2.4</code>. Check out the <code>package.json</code> file for a complete list of dependencies.</p>\n<h2>Use create-next-app</h2>\n<p>Create Next App is the fastest way to begin using this blog starter. You can use NPM or Yarn, but Yarn is recommended.</p>\n<ol>\n<li>Replace <code>my-new-blog</code> in either of the examples below (with whatever you'd like to use as the root directory), and run the command.</li>\n</ol>\n<div><pre><code class=\"language-unknown\"># with npm\nnpx create-next-app --example https://github.com/sandypockets/nextjs-blog-starter/tree/main my-new-blog</code></pre></div>\n<div><pre><code class=\"language-shell\"><span># with yarn</span>\n<span>yarn</span> create next-app <span>--example</span> https://github.com/sandypockets/nextjs-blog-starter/tree/main my-new-blog\n</code></pre></div>\n<ol start=\"2\">\n<li>Once the project is created, change into the directory.</li>\n</ol>\n<div><pre><code class=\"language-shell\"><span>cd</span> my-new-blog\n</code></pre></div>\n<ol start=\"3\">\n<li>Install dependencies.</li>\n</ol>\n<div><pre><code class=\"language-shell\"><span>yarn</span> <span>install</span>\n</code></pre></div>\n<p>or if you used npm</p>\n<div><pre><code class=\"language-shell\"><span>npm</span> <span>install</span>\n</code></pre></div>\n<h3>Development server</h3>\n<p>You can start the development server with <code>yarn</code>, <code>npm</code>, or <code>next</code>.</p>\n<div><pre><code class=\"language-shell\"><span># yarn</span>\n<span>yarn</span> dev\n\n<span># npm</span>\n<span>npm</span> dev\n\n<span># next</span>\nnext dev\n</code></pre></div>\n<p>Once the server is running, visit <a href=\"http://localhost:3000\">http://localhost:3000</a> in your browser.</p>\n<h3>Constants</h3>\n<p>Set up each of the constants, much like you would a <code>.env</code>, in the <code>lib/constants.js</code> file.</p>\n<div><pre><code class=\"language-javascript\"><span>export</span> <span>const</span> <span>EXAMPLE_PATH</span> <span>=</span> <span>'blog-starter'</span>\n<span>export</span> <span>const</span> <span>CMS_NAME</span> <span>=</span> <span>'Markdown'</span>\n<span>export</span> <span>const</span> <span>HOME_OG_IMAGE_URL</span> <span>=</span> <span>'https://og-image.vercel.app/Next.js%20Blog%20Starter%20Example.png?theme=light&#x26;md=1&#x26;fontSize=100px&#x26;images=https%3A%2F%2Fassets.vercel.com%2Fimage%2Fupload%2Ffront%2Fassets%2Fdesign%2Fnextjs-black-logo.svg'</span>\n<span>export</span> <span>const</span> <span>BLOG_NAME</span> <span>=</span> <span>'Next.js Blog Starter'</span>\n<span>export</span> <span>const</span> <span>KEYWORDS</span> <span>=</span> <span>'starter, blog, next.js, template'</span>\n<span>export</span> <span>const</span> <span>DESCRIPTION</span> <span>=</span> <span>'A starter blog template for Next.js'</span>\n<span>export</span> <span>const</span> <span>AUTHOR</span> <span>=</span> <span>'sandypockets'</span>\n<span>export</span> <span>const</span> <span>LANG</span> <span>=</span> <span>'en-CA'</span>\n<span>export</span> <span>const</span> <span>GITHUB_REPO</span> <span>=</span> <span>'https://github.com/sandypockets'</span>\n</code></pre></div>\n<h3>Generate a sitemap and robots.txt</h3>\n<p>Sitemaps are an important part of SEO. This section walks through adding your base URL to the sitemap generator. The generator runs automatically after each build, generating a new sitemap each time you update your blog.</p>\n<p>The generated sitemap can be found in <code>public/sitemap.xml</code>. This command also generates a new <code>public/robots.txt</code> file.</p>\n<ol>\n<li>Open the <code>scripts/generate.sitemap.mjs</code> file.</li>\n<li>On Line 5, replace <code>https://blog-starter.sandypockets.dev</code> with your own blog's website.</li>\n<li>On Line 6, replace <code>en-CA</code> with your preferred locale (<code>en-UK</code>, <code>en-US</code>, etc.). This is used to determine the format of the date stamp in the sitemap.</li>\n</ol>\n<p>When you're ready to test it:</p>\n<ol>\n<li>Run <code>yarn build</code></li>\n<li>Check the <code>public/</code> directory for the <code>sitemap.xml</code> file and <code>robots.txt</code> file.</li>\n<li>Run <code>yarn start</code></li>\n<li>Visit <code>http://localhost:3000/sitemap.xml</code></li>\n</ol>\n<p>If you see the xml sitemap, then it was successful.</p>\n<h3>RSS Feed</h3>\n<p>An RSS feed is available for the blog at <code>/feed.xml</code>. However, you must first configure the RSS generator to use your own URL.</p>\n<ol>\n<li>Open the <code>scripts/generate-rss.mjs</code> file.</li>\n<li>On Line 7, replace the <code>https://blog-starter.sandypockets.dev</code> value of <code>BLOG_URL</code> with your own.</li>\n</ol>\n<p>When you're ready to test it:</p>\n<ol>\n<li>Run <code>yarn build</code></li>\n<li>Check the <code>public/</code> directory for the <code>feed.xml</code> file.</li>\n<li>Run <code>yarn start</code></li>\n<li>Visit <code>http://localhost:3000/feed.xml</code></li>\n</ol>\n<p>If you see the xml RSS feed, then it was successful.</p>\n<h3>Set up Google Analytics</h3>\n<p>You will need to have your Google tag ID. If you do not have one, or do not have a Google Analytics account, you can sign up at <a href=\"https://analytics.google.com/\">analytics.google.com</a></p>\n<ol>\n<li>Create a copy of the <code>.env.local.example</code> file, and name it <code>.env.local</code>. In the terminal, run:</li>\n</ol>\n<div><pre><code class=\"language-shell\"><span>cp</span> .env.local.example .env.local\n</code></pre></div>\n<ol start=\"2\">\n<li>Grab your Google tag ID from your Analytics account, and replace the <code>G-XXXXXXXXXX</code> in the new <code>.env.local</code> file you just created.</li>\n</ol>\n<h3>Set up SendGrid</h3>\n<p>You will need a free SendGrid account, which allows you to send up to 100 emails each day. Replace the <code>REPLACE-WITH-YOUR-API-KEY</code> text in the `.env.exa</p>\n<ol>\n<li>Get your SendGrid API key from your SendGrid account.</li>\n<li>Open the <code>.env.local</code> file that you created when setting up Google Analytics.</li>\n<li>Replace <code>REPLACE-WITH-YOUR-API-KEY</code> with your actual API key from SendGrid.</li>\n</ol>\n<h3>Storybook</h3>\n<p>Storybook is handy for crafting and tweaking components. Styling components in isolation this way can help make them more composable, since they're less reliant on the environment they're rendered in. Storybook runs on a separate server, so you can run it alongside the development server if you prefer.</p>\n<ol>\n<li>To use Storybook, start the Storybook server.</li>\n</ol>\n<div><pre><code class=\"language-shell\"><span>yarn</span> storybook\n</code></pre></div>\n<ol start=\"2\">\n<li>Visit <a href=\"http://localhost:6006/\">http://localhost:6006/</a> in your browser.</li>\n</ol>\n<h2>Building for production</h2>\n<p>While it's always a good idea to check out the build, it is especially important with Tailwind CSS. Tailwind purges unused classes to keep the build size light. However, if you've added classes dynamically with JavaScript, then you should be sure those classes weren't removed during build. Learn more in the <a href=\"https://tailwindcss.com/docs/optimizing-for-production\">Optimizing for production</a> section of the Tailwind docs.</p>\n<ol>\n<li>Start building.</li>\n</ol>\n<div><pre><code class=\"language-shell\"><span>yarn</span> build\n</code></pre></div>\n<ol start=\"2\">\n<li>Once building is complete, run the build.</li>\n</ol>\n<div><pre><code class=\"language-shell\"><span>yarn</span> start\n</code></pre></div>\n<ol start=\"3\">\n<li>Visit <a href=\"http://localhost:3000\">http://localhost:3000</a> in your browser.</li>\n</ol>\n<h2>Adding content</h2>\n<p>Learn how to add content like blog posts or pages.</p>\n<h3>Add a blog post</h3>\n<ol>\n<li>Add a new Markdown file (<code>.md</code>) to the <code>/_posts</code> directory.</li>\n<li>Add the required front matter (described below) and adjust it as needed.</li>\n<li>Images related to the post should be stored in within the appropriate the <code>/public/assets/blog</code> directory. It is recommended you create a new folder for each blog post to prevent the images files from growing unwieldy.</li>\n<li>That's it. Your new post will show up alongside the others on your homepage.</li>\n</ol>\n<blockquote>\n<p>Note: The slug is the path that will be displayed, and is based on the title of your <code>.md</code> file. For example, <code>kobe.md</code> becomes <code>localhost:3000/posts/kobe</code></p>\n</blockquote>\n<h4>How it works</h4>\n<p>Blog posts are stored in the <code>/_posts</code> directory as Markdown files. To create a new post, simply add a new markdown file (<code>.md</code>) to the <code>/_posts</code> directory. Each post must include the appropriate front matter.</p>\n<p>To create the blog posts we use <a href=\"https://github.com/remarkjs/remark\"><code>remark</code></a> and <a href=\"https://github.com/remarkjs/remark-html\"><code>remark-html</code></a> to convert the Markdown files into an HTML string, and then send it down as a prop to the page. The metadata of every post is handled by <a href=\"https://github.com/jonschlinkert/gray-matter\"><code>gray-matter</code></a> and also sent in props to the page.</p>\n<h5>Front matter</h5>\n<p>An example of the required front matter:</p>\n<blockquote>\n<p>Note: The formatting of the front matter is important. Ensure the indentation remains the same.</p>\n</blockquote>\n<div><pre><code class=\"language-text\">---\ntitle: &#x26;#39;A blog starter you actually want to use&#x26;#39;\nexcerpt: &#x26;#39;There are hundreds of different blog starters out there. But none felt quite right. So I built my own. Based off the basic Next.js Blog Starter, but now with several handy features like dark mode (using local storage) or Google Analytics. It comes with Storybook too.&#x26;#39;\ncoverImage: &#x26;#39;/assets/blog/dynamic-routing/tree.jpg&#x26;#39;\ndate: &#x26;#39;2021-08-24T05:35:07.322Z&#x26;#39;\nauthor:\n  name: sandypockets\n  picture: &#x26;#39;/assets/blog/authors/sandypockets_avatar.jpg&#x26;#39;\nogImage:\n  url: &#x26;#39;/assets/blog/dynamic-routing/tree.jpg&#x26;#39;\n---</code></pre></div>\n<p>Adjust the value of each key as needed.</p>\n<h3>Add a page</h3>\n<p>Next.js makes routing easy. All pages live in the <code>/pages</code> directory. The file names used in that directory will map to the path in the browser.</p>\n<blockquote>\n<p>Example: <code>/pages/cool-page.jsx</code> becomes <code>localhost:3000/pages/cool-page</code></p>\n</blockquote>\n<h3>Manage global data</h3>\n<p>Global variables, like your blog's name, or your GitHub URL, can be managed in <code>/lib/constants.js</code></p>\n<p>You can adjust the blog's metadata (some of which relies on the global variables described above) can be adjusted in the <code>/components/Layout/Meta.jsx</code> component.</p>\n","ogImage":{"url":"/assets/blog/getting-started/cover.jpg"},"coverImage":"/assets/blog/getting-started/snowy-mountain.jpg"}},"__N_SSG":true}}